{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "explanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "questionId",
    "text",
    "author",
    "status",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "reviewed"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "locator"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    }
  }
}
