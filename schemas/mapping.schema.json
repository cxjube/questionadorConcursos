{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "questionId",
    "syllabusItemId",
    "justification",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "syllabusItemId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "confirmed"
      ]
    }
  }
}
