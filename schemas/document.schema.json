{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bankId",
    "kind",
    "title",
    "issuer",
    "status",
    "officialUrl",
    "file",
    "sha256",
    "publicationDate",
    "paperId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "bankId": {
      "const": "concursos"
    },
    "kind": {
      "enum": [
        "notice",
        "question_paper",
        "answer_key",
        "reference"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "received",
        "verified"
      ]
    },
    "officialUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "type": "null"
        }
      ]
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicationDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "paperId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
