{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "topic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "disciplineId",
    "parentId",
    "label"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "disciplineId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
