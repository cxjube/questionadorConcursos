{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bankId",
    "title",
    "provider",
    "institution",
    "role",
    "year",
    "booklet",
    "documentId",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "bankId": {
      "const": "concursos"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "institution": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2200
    },
    "booklet": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "verified",
        "received"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationDate",
        "block",
        "firstItem",
        "lastItem",
        "itemCount",
        "questionType",
        "annulledItems",
        "answerKeyDocumentId",
        "pairingStatus",
        "externalVerification"
      ],
      "properties": {
        "applicationDate": {
          "type": "string",
          "format": "date"
        },
        "block": {
          "enum": [
            "basic",
            "specific",
            "mixed"
          ]
        },
        "firstItem": {
          "type": "integer",
          "minimum": 1
        },
        "lastItem": {
          "type": "integer",
          "minimum": 1
        },
        "itemCount": {
          "type": "integer",
          "minimum": 1
        },
        "questionType": {
          "enum": [
            "multiple_choice",
            "true_false"
          ]
        },
        "annulledItems": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "answerKeyDocumentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "pairingStatus": {
          "enum": [
            "matched_by_filename_and_range",
            "matched_by_role_type_and_session"
          ]
        },
        "externalVerification": {
          "type": "boolean"
        },
        "containsPreliminaryAnswers": {
          "type": "boolean",
          "description": "The official paper includes preliminary answers/commentary; not the source of definitive grading."
        }
      }
    }
  }
}
