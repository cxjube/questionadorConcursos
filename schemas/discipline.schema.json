{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discipline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
