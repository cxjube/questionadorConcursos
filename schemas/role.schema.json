{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "role",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contestId",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "pending_review",
        "verified"
      ]
    }
  }
}
