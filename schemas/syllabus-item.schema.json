{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "syllabus-item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "noticeId",
    "roleId",
    "topicId",
    "reference",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "noticeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "confirmed",
        "documented"
      ]
    },
    "number": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)*$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourcePage": {
      "type": "integer",
      "minimum": 1
    },
    "block": {
      "enum": [
        "basic",
        "specific",
        "institutional"
      ]
    }
  }
}
